priority = 0
defense_priority = 3
defense_hold_ticks = 10
hunts_turrets = true
abilities = Array[StringName]([&"salvo", &"wall", &"cloud"])
building_weights = Dictionary[StringName, int]({&"swarmer": 3, &"outpost": 3, &"mortar": 2})
