[gd_resource type="Resource" script_class="RobotProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://ai/robot_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
id = &"game"
name_key = "ROBOT_GAME"
upgrade_weights = Dictionary[StringName, int]({&"damage": 6, &"rate": 6, &"range": 6, &"yield": 6, &"spores": 4, &"crit": 3, &"splash": 3, &"bounce": 2, &"regen": 3, &"heal": 3, &"cell_hp": 3, &"turret_hp": 3})
mutation_weights = Dictionary[StringName, int]({&"heavy_spores": 5, &"light_spores": 5, &"spore_burst": 5, &"pioneer": 5, &"predator": 5, &"long_hyphae": 6, &"miser": 5, &"toxic": 4, &"gland": 4, &"cohesion": 5, &"deep_roots": 5, &"armored": 5, &"tenacious": 4, &"healer": 4, &"swift": 3})
priority = 1
defense_priority = 3
defense_hold_ticks = 10
hunts_turrets = true
moves_turret = true
step_min_owned_neighbors = 4
step_pause_ticks = 20
abilities = Array[StringName]([&"salvo", &"wall", &"cloud"])
