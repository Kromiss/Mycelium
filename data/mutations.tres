[gd_resource type="Resource" script_class="MutationTable" load_steps=7 format=3]

[ext_resource type="Script" path="res://sim/defs/mutation_def.gd" id="1_item"]
[ext_resource type="Script" path="res://sim/defs/mutation_table.gd" id="2_table"]

[sub_resource type="Resource" id="mutation_1"]
script = ExtResource("1_item")
id = &"cohesion"
name_key = "MUTATION_COHESION"
desc_key = "MUTATION_COHESION_DESC"
cohesion_pm = 2000

[sub_resource type="Resource" id="mutation_2"]
script = ExtResource("1_item")
id = &"tenacious"
name_key = "MUTATION_TENACIOUS"
desc_key = "MUTATION_TENACIOUS_DESC"
regen_pm = 2000

[sub_resource type="Resource" id="mutation_3"]
script = ExtResource("1_item")
id = &"deep_roots"
name_key = "MUTATION_DEEP_ROOTS"
desc_key = "MUTATION_DEEP_ROOTS_DESC"
deep_production_pm = 1300

[sub_resource type="Resource" id="mutation_4"]
script = ExtResource("1_item")
id = &"armored"
name_key = "MUTATION_ARMORED"
desc_key = "MUTATION_ARMORED_DESC"
turret_hp_pm = 2000

[sub_resource type="Resource" id="mutation_5"]
script = ExtResource("1_item")
id = &"miser"
name_key = "MUTATION_MISER"
desc_key = "MUTATION_MISER_DESC"
cost_pm = 850

[resource]
script = ExtResource("2_table")
mutations = Array[ExtResource("1_item")]([SubResource("mutation_1"), SubResource("mutation_2"), SubResource("mutation_3"), SubResource("mutation_4"), SubResource("mutation_5")])
