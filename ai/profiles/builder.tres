[gd_resource type="Resource" script_class="RobotProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://ai/robot_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
id = &"builder"
name_key = "ROBOT_BUILDER"
upgrade_weights = Dictionary[StringName, int]({&"yield": 10, &"regen": 6, &"heal": 6, &"cell_hp": 6, &"turret_hp": 5, &"damage": 4, &"rate": 4, &"range": 2, &"spores": 2, &"splash": 1, &"crit": 1, &"bounce": 1})
mutation_weights = Dictionary[StringName, int]({&"cohesion": 9, &"deep_roots": 8, &"tenacious": 8, &"healer": 7, &"armored": 6, &"miser": 6, &"gland": 5, &"pioneer": 4, &"light_spores": 3, &"heavy_spores": 3, &"spore_burst": 3, &"long_hyphae": 3, &"predator": 2, &"toxic": 2})
priority = 1
defense_priority = 2
defense_hold_ticks = 10
hunts_turrets = false
abilities = Array[StringName]([&"salvo", &"wall", &"cloud"])
