priority = 1
defense_priority = 3
defense_hold_ticks = 10
hunts_turrets = true
abilities = Array[StringName]([&"salvo", &"wall", &"cloud"])
building_weights = Dictionary[StringName, int]({&"outpost": 6, &"swarmer": 2, &"mortar": 2})
