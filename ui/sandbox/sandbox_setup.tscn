[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/sandbox/sandbox_setup.gd" id="1_setup"]
[ext_resource type="PackedScene" path="res://ui/sandbox/settings_form.tscn" id="2_form"]

[node name="SandboxSetup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_setup")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="Center" type="CenterContainer" parent="Scroll/Margin"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Scroll/Margin/Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Scroll/Margin/Center/Column"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "SANDBOX_TITLE"
horizontal_alignment = 1

[node name="Intro" type="Label" parent="Scroll/Margin/Center/Column"]
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "SANDBOX_INTRO"
horizontal_alignment = 1

[node name="SettingsForm" parent="Scroll/Margin/Center/Column" instance=ExtResource("2_form")]
unique_name_in_owner = true
layout_mode = 2

[node name="ErrorLabel" type="Label" parent="Scroll/Margin/Center/Column"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Scroll/Margin/Center/Column"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 20

[node name="BackButton" type="Button" parent="Scroll/Margin/Center/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "SANDBOX_BACK"

[node name="DefaultsButton" type="Button" parent="Scroll/Margin/Center/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "SANDBOX_DEFAULTS"

[node name="LaunchButton" type="Button" parent="Scroll/Margin/Center/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "SANDBOX_LAUNCH"
