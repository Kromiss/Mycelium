# SITE_ADDRESS is the prod domain (automatic HTTPS via Let's Encrypt) or ":80" for a staging slot,
# which is reached through the prod Caddy (see the sites/ import below).
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /ws {
		reverse_proxy server:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		# Browser notifications: the service worker must always be fresh.
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Extra sites written by deploy-staging.sh on the server (prod only): one file per staging slot.
import /etc/caddy/sites/*.caddy
