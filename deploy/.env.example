# Copy to .env on the server (chmod 600). Never commit the real file.
# Generate secrets with: openssl rand -hex 24   /   openssl rand -hex 32
DOMAIN=mycelium.example.com
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
# Optional: base domain for staging slots, e.g. staging.203-0-113-10.sslip.io -> a.staging.203-0-113-10.sslip.io
STAGING_BASE_DOMAIN=
